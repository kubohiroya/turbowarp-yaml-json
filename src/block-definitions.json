{
  "extensionName": "TurboWarp YAML/JSON",
  "blocks": [
    {
      "opcode": "string",
      "blockType": "REPORTER",
      "text": "string [VALUE]",
      "description": "Creates a string value.",
      "arguments": {"VALUE": {"type": "STRING", "defaultValue": "sensor"}}
    },
    {
      "opcode": "number",
      "blockType": "REPORTER",
      "text": "number [VALUE]",
      "description": "Creates a finite number value.",
      "arguments": {"VALUE": {"type": "NUMBER", "defaultValue": 21}}
    },
    {
      "opcode": "boolean",
      "blockType": "REPORTER",
      "text": "boolean [VALUE]",
      "description": "Creates a boolean value.",
      "arguments": {"VALUE": {"type": "BOOLEAN", "defaultValue": true}}
    },
    {
      "opcode": "nullValue",
      "blockType": "REPORTER",
      "text": "null",
      "description": "Creates a null value.",
      "arguments": {}
    },
    {
      "opcode": "pair",
      "blockType": "REPORTER",
      "text": "pair key [KEY] value [VALUE]",
      "description": "Creates a map key/value pair.",
      "arguments": {
        "KEY": {"type": "STRING", "defaultValue": "temperature"},
        "VALUE": {"type": "STRING", "defaultValue": "21"}
      }
    },
    {
      "opcode": "map",
      "blockType": "REPORTER",
      "text": "map [ENTRIES]",
      "description": "Creates an object/map from pair fragments.",
      "arguments": {"ENTRIES": {"type": "STRING", "defaultValue": ""}}
    },
    {
      "opcode": "sequence",
      "blockType": "REPORTER",
      "text": "sequence [ITEMS]",
      "description": "Creates an array/sequence from item fragments.",
      "arguments": {"ITEMS": {"type": "STRING", "defaultValue": ""}}
    },
    {
      "opcode": "concat",
      "blockType": "REPORTER",
      "text": "[LEFT] followed by [RIGHT]",
      "description": "Combines fragments without mutating either input.",
      "arguments": {
        "LEFT": {"type": "STRING", "defaultValue": ""},
        "RIGHT": {"type": "STRING", "defaultValue": ""}
      }
    },
    {
      "opcode": "renderYaml",
      "blockType": "REPORTER",
      "text": "render YAML [FRAGMENT]",
      "description": "Renders a fragment to YAML text.",
      "arguments": {"FRAGMENT": {"type": "STRING", "defaultValue": ""}}
    },
    {
      "opcode": "renderJson",
      "blockType": "REPORTER",
      "text": "render JSON [FRAGMENT]",
      "description": "Renders a fragment to formatted JSON text.",
      "arguments": {"FRAGMENT": {"type": "STRING", "defaultValue": ""}}
    },
    {
      "opcode": "validateSchema",
      "blockType": "REPORTER",
      "text": "validate JSON Schema [SCHEMA] data [FRAGMENT]",
      "description": "Returns JSON Schema validation details for the built data.",
      "arguments": {
        "SCHEMA": {
          "type": "STRING",
          "defaultValue": "{\"type\":\"object\",\"required\":[\"temperature\"]}"
        },
        "FRAGMENT": {"type": "STRING", "defaultValue": ""}
      }
    },
    {
      "opcode": "isValidSchema",
      "blockType": "BOOLEAN",
      "text": "JSON Schema [SCHEMA] accepts data [FRAGMENT]?",
      "description": "Reports whether the built data passes JSON Schema validation.",
      "arguments": {
        "SCHEMA": {
          "type": "STRING",
          "defaultValue": "{\"type\":\"object\",\"required\":[\"temperature\"]}"
        },
        "FRAGMENT": {"type": "STRING", "defaultValue": ""}
      }
    }
  ]
}
